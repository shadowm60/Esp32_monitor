# Esp32_monitor defaults (Waveshare ESP32-S3-Touch-LCD-7, ESP32-S3-N16R8).
# sdkconfig is local and not committed: change defaults here.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# PSRAM (8 MB octal); frame buffers, Wi-Fi/LWIP and NimBLE buffers go there
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Statics tagged EXT_RAM_BSS_ATTR (big UI / service buffers) live in PSRAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Plain malloc() prefers PSRAM for every size (default: < 16 KB internal first).
# LVGL objects/styles and EEZ Flow values are thousands of small mallocs and
# used up internal RAM next to Wi-Fi + BT. Code that needs internal RAM (DMA,
# ISR, FreeRTOS objects, Wi-Fi/BT internals) asks for it with heap_caps_*.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
# Internal RAM is the tight resource (Wi-Fi + BLE + RGB bounce buffers + the
# LVGL render buffer): Wi-Fi speed is not important for a monitor.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# GPIO19/20 (native USB) become the CAN bus while CAN runs: console on UART0,
# the board's "UART" USB-C port (CH343).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Bluetooth LE only (the S3 has no classic BT), NimBLE host, central role
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# SD card: long file names for YYYYMMDD_HHMMSS.log
CONFIG_FATFS_LFN_HEAP=y

# Display (BSW = board support from FP_Dash)
CONFIG_BSW_LVGL_PORT_TASK_CORE=1
CONFIG_BSW_LVGL_PORT_TASK_STACK_SIZE_KB=10
CONFIG_BSW_LVGL_PORT_AVOID_TEAR_ENABLE=y
CONFIG_BSW_LVGL_PORT_AVOID_TEAR_MODE_4=y
# 20 lines x 800 px x 2 B = 32 KB internal RAM (FP_Dash uses 40 = 64 KB)
CONFIG_BSW_LVGL_PORT_SRAM_BUF_HEIGHT=20
CONFIG_BSW_LVGL_PORT_PERF_LOG=n

# Board pins (Waveshare ESP32-S3-Touch-LCD-7 V1.2)
CONFIG_CAN_TX=20
CONFIG_CAN_RX=19
CONFIG_I2C_MASTER_SCL=9
CONFIG_I2C_MASTER_SDA=8
CONFIG_SDCARD_PIN_MOSI=11
CONFIG_SDCARD_PIN_MISO=13
CONFIG_SDCARD_PIN_CLK=12
CONFIG_SDCARD_PIN_CS=-1

# LVGL 8
CONFIG_LV_COLOR_SCREEN_TRANSP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_DISP_DEF_REFR_PERIOD=15
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LV_USE_FONT_COMPRESSED=y
# CONFIG_LV_USE_DEMO_WIDGETS is not set
# CONFIG_LV_USE_DEMO_BENCHMARK is not set
# CONFIG_LV_USE_DEMO_STRESS is not set
# CONFIG_LV_USE_DEMO_MUSIC is not set
